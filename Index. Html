<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>الإعراب الذكي</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Traditional Arabic', 'Amiri', 'Helvetica Neue', serif;
            background: linear-gradient(135deg, #f5f0e8 0%, #e8e0d5 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px;
        }
        .container {
            background: #fffcf7;
            border-radius: 24px;
            padding: 25px 20px 30px;
            max-width: 750px;
            width: 100%;
            box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        }
        h1 {
            text-align: center;
            color: #5a3e2b;
            font-size: 28px;
            margin-bottom: 25px;
            font-weight: 700;
        }
        .input-area {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }
        .input-area input {
            flex: 1;
            padding: 16px 18px;
            border: 2px solid #ddd0c4;
            border-radius: 14px;
            font-size: 22px;
            font-family: inherit;
            background: #faf8f5;
            min-width: 150px;
        }
        .input-area input:focus {
            outline: none;
            border-color: #b8927a;
            box-shadow: 0 0 0 3px rgba(184,146,122,0.15);
        }
        .input-area button {
            padding: 16px 28px;
            border: none;
            border-radius: 14px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            background: #8b6f58;
            color: white;
            transition: 0.3s;
            font-family: inherit;
        }
        .input-area button:active { transform: scale(0.95); }
        .result-area {
            background: #f8f3ed;
            border-radius: 16px;
            padding: 20px;
            min-height: 90px;
            border: 2px dashed #ddd0c4;
            margin-bottom: 15px;
        }
        .word-item {
            display: inline-block;
            margin: 6px 8px 6px 0;
            padding: 8px 14px;
            border-radius: 12px;
            font-size: 22px;
            font-weight: 500;
            background: white;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            border-right: 5px solid;
        }
        .word-text { display: block; line-height: 1.3; }
        .word-irab { display: block; font-size: 13px; font-weight: 400; color: #6a5a4a; margin-top: 3px; }
        .empty-message { color: #b0a090; font-size: 17px; text-align: center; padding: 15px 0; }
        .error-message { color: #c0392b; background: #fdedec; padding: 12px; border-radius: 12px; text-align: center; }
        .controls {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .controls button {
            padding: 12px 25px;
            border: none;
            border-radius: 14px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            font-family: inherit;
            flex: 1;
            min-width: 100px;
        }
        .btn-new { background: #d4c5b8; color: #4a3728; }
        .btn-exit { background: #c0392b; color: white; }
        .btn-save { background: #27ae60; color: white; }
        .btn-exit:active { transform: scale(0.95); }
        .btn-new:active { transform: scale(0.95); }
        .btn-save:active { transform: scale(0.95); }
        .footer { text-align: center; margin-top: 18px; font-size: 12px; color: #b0a090; }
        .credit {
            text-align: center;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #e8e0d5;
            font-family: 'Traditional Arabic', 'Amiri', 'Helvetica Neue', serif;
            font-size: 16px;
            font-weight: 500;
            color: #5a3e2b;
            letter-spacing: 0.5px;
        }
        .credit span {
            color: #8b6f58;
            font-weight: 700;
        }
        .loader { display: inline-block; width: 18px; height: 18px; border: 3px solid #ddd; border-radius: 50%; border-top-color: #8b6f58; animation: spin 0.8s linear infinite; vertical-align: middle; margin-right: 6px; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .closed-message { text-align: center; padding: 50px 20px; color: #5a3e2b; }
        .closed-message h2 { font-size: 30px; }
        .closed-message button {
            padding: 12px 28px;
            border: none;
            border-radius: 12px;
            background: #8b6f58;
            color: white;
            font-size: 18px;
            cursor: pointer;
            font-family: inherit;
        }
        .save-success {
            background: #d5f5e3;
            color: #27ae60;
            padding: 10px;
            border-radius: 10px;
            text-align: center;
            margin-top: 10px;
            font-size: 15px;
            font-weight: 600;
        }
    </style>
</head>
<body>

<div class="container" id="appContainer">
    <h1>📖 الإعراب الذكي</h1>

    <div class="input-area">
        <input type="text" id="sentenceInput" placeholder="مثال: الولد قوي" />
        <button id="analyzeBtn" onclick="analyze()">🔍 إعراب</button>
    </div>

    <div class="result-area" id="resultArea">
        <div class="empty-message">✍️ اكتب جملة ثم اضغط "إعراب"</div>
    </div>

    <div class="controls">
        <button class="btn-new" onclick="newSentence()">📝 جملة جديدة</button>
        <button class="btn-save" onclick="saveResult()">💾 حفظ النتيجة</button>
        <button class="btn-exit" onclick="exitApp()">🚪 خروج</button>
    </div>

    <div class="credit">
        <span>🤍</span> Done by <span>Eng. Mohammed Fawzi</span> <span>🤍</span>
    </div>

    <div class="footer">⚡ إعراب دقيق باستخدام الذكاء الاصطناعي</div>
</div>

<script>
    // ================================================================
    // 🔑 مفتاح API (مخفي داخل الكود - لا يراه المستخدم)
    // ================================================================
    const API_KEY = 'i3rb_485c9a7068450213202e184a03426242821beec98c3d9579c5c406829489faea';

    // متغير لتخزين آخر نتيجة إعراب
    let lastResult = {
        sentence: '',
        words: []
    };

    // ================================================================
    // الإعدادات
    // ================================================================
    const COLORS = {
        'noun': '#2980b9',
        'verb': '#e74c3c',
        'particle': '#1abc9c',
        'pronoun': '#8e44ad',
        'adverb': '#e67e22',
        'preposition': '#2c3e50',
        'conjunction': '#16a085',
        'interjection': '#d35400',
        'default': '#95a5a6'
    };

    const TYPE_TRANSLATION = {
        'noun': 'اسم',
        'verb': 'فعل',
        'particle': 'حرف',
        'pronoun': 'ضمير',
        'adverb': 'ظرف',
        'preposition': 'حرف جر',
        'conjunction': 'حرف عطف',
        'interjection': 'أداة'
    };

    // ================================================================
    // دالة استخراج الإعراب من كائن parsing
    // ================================================================
    function extractParsing(parsing) {
        if (!parsing) return 'إعراب غير محدد';
        if (typeof parsing === 'string') return parsing;
        if (parsing.details) return parsing.details;
        if (parsing.role && parsing.case) {
            return `${parsing.role} ${parsing.case}`;
        }
        if (parsing.role) return parsing.role;
        if (parsing.case) return parsing.case;
        return 'إعراب غير محدد';
    }

    // ================================================================
    // الوضع الاحتياطي (في حال فشل API)
    // ================================================================
    function smartParse(sentence) {
        const words = sentence.split(/\s+/).filter(w => w.length > 0);
        if (words.length === 0) return [];

        const VERBS = ['أكل', 'شرب', 'ذهب', 'جاء', 'قرأ', 'كتب', 'نام', 'قام', 'جلس', 'وقف', 'ركض', 'سبح', 'طار', 'أتى', 'خرج', 'دخل', 'أمسك', 'رمى', 'أخذ', 'ترك', 'فتح', 'غلق', 'نظر', 'سمع', 'تكلم', 'قال', 'رأى', 'علم', 'ظن', 'حسب'];
        const PRESENT_PREFIXES = ['ي', 'ت', 'أ', 'ن'];
        const PREPOSITIONS = ['في', 'على', 'من', 'إلى', 'عن', 'مع', 'ب', 'ل', 'ك', 'حتى', 'خلال', 'بين', 'تحت', 'فوق', 'أمام', 'خلف', 'قرب', 'بعيد'];
        const CONJUNCTIONS = ['و', 'ف', 'ثم', 'أو', 'لكن', 'بل'];
        const DEFINITE = 'ال';

        const clean = words.map(w => w.replace(/[،،؛؛!؟.،,;:!?]/g, ''));
        let isVerbal = false;
        const first = clean[0];
        if (VERBS.includes(first) || (first.length > 2 && PRESENT_PREFIXES.includes(first[0]) && !first.startsWith(DEFINITE))) {
            isVerbal = true;
        }

        const results = [];
        let i = 0;

        if (isVerbal) {
            if (i < words.length) {
                const isPast = VERBS.includes(clean[i]);
                results.push({ word: words[i], irab: isPast ? 'فعل ماضٍ مبني على الفتح' : 'فعل مضارع مرفوع', type: 'verb' });
                i++;
            }
            if (i < words.length) {
                const w = words[i];
                const c = clean[i];
                if (!PREPOSITIONS.includes(c) && !CONJUNCTIONS.includes(c)) {
                    let irab = 'فاعل مرفوع';
                    if (c.startsWith(DEFINITE)) irab += ' (معرفة)';
                    else irab += ' (نكرة)';
                    results.push({ word: w, irab: irab, type: 'noun' });
                    i++;
                }
            }
            while (i < words.length) {
                const w = words[i];
                const c = clean[i];
                if (PREPOSITIONS.includes(c)) {
                    results.push({ word: w, irab: 'حرف جر مبني', type: 'preposition' });
                    i++;
                    if (i < words.length) {
                        results.push({ word: words[i], irab: 'اسم مجرور (مضاف إليه)', type: 'noun' });
                        i++;
                    }
                } else if (CONJUNCTIONS.includes(c)) {
                    results.push({ word: w, irab: 'حرف عطف', type: 'conjunction' });
                    i++;
                } else {
                    if (i === 2 || (results.length > 0 && results[results.length-1].type === 'noun')) {
                        results.push({ word: w, irab: 'مفعول به منصوب', type: 'noun' });
                    } else {
                        results.push({ word: w, irab: 'نعت / عطف (تابع)', type: 'noun' });
                    }
                    i++;
                }
            }
        } else {
            if (i < words.length) {
                const w = words[i];
                const c = clean[i];
                if (PREPOSITIONS.includes(c)) {
                    results.push({ word: w, irab: 'حرف جر مبني', type: 'preposition' });
                    i++;
                    if (i < words.length) {
                        results.push({ word: words[i], irab: 'اسم مجرور (مضاف إليه)', type: 'noun' });
                        i++;
                    }
                } else if (CONJUNCTIONS.includes(c)) {
                    results.push({ word: w, irab: 'حرف عطف', type: 'conjunction' });
                    i++;
                } else {
                    let irab = 'مبتدأ مرفوع';
                    if (c.startsWith(DEFINITE)) irab += ' (معرفة)';
                    else irab += ' (نكرة)';
                    results.push({ word: w, irab: irab, type: 'noun' });
                    i++;
                }
            }
            if (i < words.length) {
                const w = words[i];
                const c = clean[i];
                if (PREPOSITIONS.includes(c)) {
                    results.push({ word: w, irab: 'حرف جر مبني', type: 'preposition' });
                    i++;
                    if (i < words.length) {
                        results.push({ word: words[i], irab: 'اسم مجرور (خبر شبه جملة)', type: 'noun' });
                        i++;
                    }
                } else if (CONJUNCTIONS.includes(c)) {
                    results.push({ word: w, irab: 'حرف عطف', type: 'conjunction' });
                    i++;
                } else {
                    let irab = 'خبر مرفوع';
                    if (c.startsWith(DEFINITE)) irab += ' (معرفة)';
                    else irab += ' (نكرة)';
                    results.push({ word: w, irab: irab, type: 'noun' });
                    i++;
                }
            }
            while (i < words.length) {
                const w = words[i];
                const c = clean[i];
                if (PREPOSITIONS.includes(c)) {
                    results.push({ word: w, irab: 'حرف جر', type: 'preposition' });
                    i++;
                    if (i < words.length) {
                        results.push({ word: words[i], irab: 'مضاف إليه مجرور', type: 'noun' });
                        i++;
                    }
                } else if (CONJUNCTIONS.includes(c)) {
                    results.push({ word: w, irab: 'حرف عطف', type: 'conjunction' });
                    i++;
                } else {
                    results.push({ word: w, irab: 'نعت / عطف (تابع)', type: 'noun' });
                    i++;
                }
            }
        }
        return results;
    }

    // ================================================================
    // الإعراب الرئيسي
    // ================================================================
    async function analyze() {
        const input = document.getElementById('sentenceInput');
        const resultArea = document.getElementById('resultArea');
        const btn = document.getElementById('analyzeBtn');
        const sentence = input.value.trim();

        if (!sentence) {
            resultArea.innerHTML = `<div class="empty-message">⚠️ اكتب جملة أولاً</div>`;
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '⏳ جاري...';

        try {
            const response = await fetch('https://api.i3rbly.com/v1/parse', {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${API_KEY}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ sentence: sentence })
            });

            const textResponse = await response.text();
            let json = null;
            try { json = JSON.parse(textResponse); } catch (_) {}

            if (response.ok && json && json.success !== false) {
                let words = [];
                if (json.data && json.data.words) words = json.data.words;
                else if (json.words) words = json.words;

                const formattedWords = words.map(item => {
                    const word = item.word || item.text || '?';
                    let irab = 'إعراب غير محدد';
                    if (item.parsing) {
                        irab = extractParsing(item.parsing);
                    } else if (item.irab) {
                        irab = item.irab;
                    } else if (item.analysis) {
                        irab = item.analysis;
                    }
                    const type = item.type || 'default';
                    const typeAr = TYPE_TRANSLATION[type] || type;
                    if (!irab.includes(typeAr) && typeAr !== type) {
                        irab = `${irab} (${typeAr})`;
                    }
                    return { word: word, irab: irab, type: type };
                });

                if (formattedWords.length > 0) {
                    // حفظ النتيجة للتخزين
                    lastResult.sentence = sentence;
                    lastResult.words = formattedWords;
                    displayWords(formattedWords, resultArea);
                } else {
                    throw new Error('لم يتم العثور على كلمات');
                }
            } else {
                const words = smartParse(sentence);
                lastResult.sentence = sentence;
                lastResult.words = words;
                displayWords(words, resultArea);
                resultArea.innerHTML += `<div class="error-message" style="margin-top:10px;font-size:13px;">⚠️ تم استخدام المحلل الاحتياطي (بدون إنترنت)</div>`;
            }
        } catch (error) {
            console.error(error);
            const words = smartParse(sentence);
            lastResult.sentence = sentence;
            lastResult.words = words;
            displayWords(words, resultArea);
            resultArea.innerHTML += `<div class="error-message" style="margin-top:10px;font-size:13px;">⚠️ تم استخدام المحلل الاحتياطي (بدون إنترنت)</div>`;
        } finally {
            btn.disabled = false;
            btn.innerHTML = '🔍 إعراب';
        }
    }

    // ================================================================
    // عرض النتائج
    // ================================================================
    function displayWords(words, resultArea) {
        if (!words || words.length === 0) {
            resultArea.innerHTML = `<div class="empty-message">⚠️ لم يتم التعرف على كلمات</div>`;
            return;
        }
        let html = '';
        words.forEach(item => {
            const word = item.word || '?';
            const irab = item.irab || 'إعراب غير محدد';
            const type = item.type || 'default';
            const color = COLORS[type] || COLORS['default'];
            html += `
                <span class="word-item" style="border-right-color: ${color};">
                    <span class="word-text">${word}</span>
                    <span class="word-irab">${irab}</span>
                </span>
            `;
        });
        resultArea.innerHTML = html;
    }

    // ================================================================
    // حفظ النتيجة إلى ملف
    // ================================================================
    function saveResult() {
        if (lastResult.words.length === 0) {
            alert('⚠️ لا توجد نتيجة للحفظ. قم بإعراب جملة أولاً.');
            return;
        }

        // بناء محتوى الملف
        const now = new Date();
        const dateStr = now.toLocaleDateString('ar-EG') + ' ' + now.toLocaleTimeString('ar-EG');
        
        let content = '═══════════════════════════════════════\n';
        content += '        📖 نتيجة الإعراب\n';
        content += '═══════════════════════════════════════\n\n';
        content += `📝 الجملة: ${lastResult.sentence}\n\n`;
        content += '┌─────────────┬────────────────────────────┐\n';
        content += '│   الكلمة    │         الإعراب           │\n';
        content += '├─────────────┼────────────────────────────┤\n';
        
        lastResult.words.forEach(item => {
            const word = item.word || '?';
            const irab = item.irab || 'إعراب غير محدد';
            // تنسيق الجدول
            const wordPad = word.padEnd(11, ' ');
            const irabPad = irab.padEnd(26, ' ');
            content += `│ ${wordPad} │ ${irabPad} │\n`;
        });
        
        content += '└─────────────┴────────────────────────────┘\n\n';
        content += `📅 التاريخ: ${dateStr}\n`;
        content += '═══════════════════════════════════════\n';
        content += '🤍 Done by Eng. Mohammed Fawzi\n';

        // إنشاء ملف و تنزيله
        try {
            const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            
            // اسم الملف: اعراب_التاريخ.txt
            const fileName = `اعراب_${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}.txt`;
            link.download = fileName;
            
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(link.href);
            
            // رسالة نجاح
            const resultArea = document.getElementById('resultArea');
            resultArea.innerHTML += `
                <div class="save-success">✅ تم حفظ الملف بنجاح في مجلد التنزيلات 📁</div>
            `;
            
        } catch (error) {
            alert('❌ فشل حفظ الملف: ' + error.message);
        }
    }

    // ================================================================
    // أزرار التحكم
    // ================================================================
    function newSentence() {
        document.getElementById('sentenceInput').value = '';
        document.getElementById('resultArea').innerHTML = '<div class="empty-message">✍️ اكتب جملة ثم اضغط "إعراب"</div>';
        document.getElementById('sentenceInput').focus();
        // إعادة تعيين النتيجة المحفوظة
        lastResult = { sentence: '', words: [] };
    }

    function exitApp() {
        if (!window.close()) {
            document.getElementById('appContainer').innerHTML = `
                <div class="closed-message">
                    <h2>🔒 تم الإغلاق</h2>
                    <p>أغلق علامة التبويب الآن.</p>
                    <br>
                    <button onclick="location.reload()">🔄 إعادة التشغيل</button>
                </div>
            `;
        }
    }

    // دعم Enter
    document.getElementById('sentenceInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') analyze();
    });
</script>

</body>
</html>    
